# Dev local — NÃO commitar .env com segredos reais.
# Chaves alinhadas ao portfolio microservicos-ai-orchestrator/svc-rag.

INTERNAL_KEY=dev-namastex-key
ALLOW_OPEN_ACCESS=0
VECTOR_STORE=qdrant
