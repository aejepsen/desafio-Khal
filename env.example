# Copie para `.env` e ajuste. Nunca commite secrets.

INTERNAL_KEY=dev-namastex-key

# LLM (Ollama no compose)
BACKEND=ollama
BACKEND_URL=http://ollama:11434
# 7B Q4 (~4.5–5.5 GB VRAM) — cabe na RTX 3060 12 GB junto com Whisper small
DEFAULT_MODEL=qwen2.5:7b
INFERENCE_MODEL=qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=namastex-graph
NEO4J_SEED_ON_BOOT=1
NEO4J_INGEST_DATASET_ON_BOOT=1
NEO4J_INGEST_LIMIT=0
NEO4J_HEAP_INIT=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m

# ASR (compose completo; default = GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

QUOTE_FAILURE_RATE=0.20
QUOTE_SLOW_SECONDS=8

# Observability (raspa /metrics do agente + inference + rag + guardrails)
# Ver docs/metricas-modelo.md
# ALLOW_LOCAL_UPSTREAM / UPSTREAM_KEY / OBS_UPSTREAMS já vêm no docker-compose.yml
